# Configurações do Baixar Social Media
# Nomes devem bater exatamente com os campos de Settings (core/config.py) —
# pydantic-settings não usa prefixo "APP_".
HOST="127.0.0.1"
PORT=8000
DEBUG=true

# Número de downloads processados em paralelo (thread pool).
DOWNLOAD_MAX_WORKERS=4

# Teto de tamanho de arquivo aceito por download, em bytes. Default: 2GB.
DOWNLOAD_MAX_FILESIZE_BYTES=2147483648

# Teto de duração aceita por download, em segundos. Default: 3h (10800s).
DOWNLOAD_MAX_DURATION_SECONDS=10800
